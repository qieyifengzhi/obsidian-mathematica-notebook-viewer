{
  "name": "obsidian-mathematica-notebook-viewer",
  "version": "1.0.2",
  "description": "Read-only Wolfram Mathematica Notebook viewer for Obsidian",
  "main": "main.js",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "test": "vitest run",
    "test:bundle": "npm run build && node scripts/smoke-bundle.mjs",
    "test:local": "node scripts/check-local-notebooks.mjs",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "katex": "0.19.0"
  },
  "devDependencies": {
    "@types/katex": "0.16.7",
    "@types/node": "22.15.17",
    "esbuild": "0.25.5",
    "jsdom": "26.1.0",
    "obsidian": "1.14.4",
    "postcss": "8.5.6",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
